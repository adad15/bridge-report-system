if(NOT DEFINED ROOT OR NOT DEFINED OUTPUT_DIR OR NOT DEFINED CONFIGURATION)
  message(FATAL_ERROR "Build metadata requires ROOT, OUTPUT_DIR and CONFIGURATION")
endif()
file(GLOB_RECURSE inputs RELATIVE "${ROOT}" "${ROOT}/src/*.cpp" "${ROOT}/include/*.hpp" "${ROOT}/cmake/*.cmake" "${ROOT}/tools/*.cpp")
list(APPEND inputs CMakeLists.txt CMakePresets.json vcpkg.json)
list(SORT inputs)
set(material "")
foreach(input IN LISTS inputs)
  file(SHA256 "${ROOT}/${input}" digest)
  string(APPEND material "${input}:${digest}\n")
endforeach()
string(SHA256 source_digest "${material}")
set(dependency_digest "unavailable")
if(EXISTS "${INSTALLED_DIR}/vcpkg/status")
  file(SHA256 "${INSTALLED_DIR}/vcpkg/status" dependency_digest)
endif()
set(toolchain_digest "unavailable")
if(EXISTS "${TOOLCHAIN}")
  file(SHA256 "${TOOLCHAIN}" toolchain_digest)
endif()
execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE git_result)
if(NOT git_result EQUAL 0)
  set(revision "unavailable")
endif()
execute_process(COMMAND git -C "${ROOT}" status --porcelain --untracked-files=normal OUTPUT_VARIABLE dirty_output ERROR_QUIET)
set(dirty false)
if(NOT dirty_output STREQUAL "")
  set(dirty true)
endif()
string(SHA256 build_id "${source_digest}|${CONFIGURATION}|${COMPILER_ID}|${COMPILER_VERSION}|${COMPILER_TARGET}|${CMAKE_VERSION}|${dependency_digest}|${toolchain_digest}|${revision}|${dirty}")
set(metadata "{\"build_id\":\"${build_id}\",\"source_digest\":\"${source_digest}\",\"git_revision\":\"${revision}\",\"worktree_dirty\":${dirty},\"configuration\":\"${CONFIGURATION}\",\"dependency_digest\":\"${dependency_digest}\",\"compiler\":\"${COMPILER_ID} ${COMPILER_VERSION}\"}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(header "#pragma once\nnamespace bridge_report::runtime { inline constexpr char kBuildMetadata[] = R\"metadata(${metadata})metadata\"; }\n")
foreach(kind IN ITEMS header metadata)
  if(kind STREQUAL "header")
    set(path "${OUTPUT_DIR}/BuildMetadata.hpp")
    set(content "${header}")
  else()
    set(path "${OUTPUT_DIR}/build-info.json")
    set(content "${metadata}\n")
  endif()
  set(old "")
  if(EXISTS "${path}")
    file(READ "${path}" old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE "${path}" "${content}")
  endif()
endforeach()
