{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge-report.local/schemas/technical-condition-package.schema.json",
  "title": "Technical condition standard package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard_family",
    "standard_id",
    "standard_code",
    "standard_name",
    "official_edition",
    "package_version",
    "contract_version",
    "algorithm_id",
    "effective_date",
    "content_checksum",
    "status",
    "entry_files"
  ],
  "properties": {
    "standard_family": {"const": "technical_condition"},
    "standard_id": {"type": "string", "minLength": 1},
    "standard_code": {"type": "string", "minLength": 1},
    "standard_name": {"type": "string", "minLength": 1},
    "official_edition": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract_version": {"const": 1},
    "algorithm_id": {"type": "string", "minLength": 1},
    "effective_date": {"type": "string", "format": "date"},
    "content_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"const": "active"},
    "entry_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.json$"}
    }
  }
}
