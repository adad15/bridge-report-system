{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge-report.local/schemas/rating-tree-extension-package.schema.json",
  "title": "Read-only organization rating tree extension package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_type",
    "tree_code",
    "tree_name",
    "package_version",
    "contract_version",
    "status",
    "content_checksum",
    "entry_files"
  ],
  "properties": {
    "package_type": {"const": "rating_tree_extension"},
    "tree_code": {"type": "string", "minLength": 1},
    "tree_name": {"type": "string", "minLength": 1},
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contract_version": {"const": 1},
    "status": {"const": "active"},
    "content_checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entry_files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.json$"
      }
    }
  },
  "$defs": {
    "keyword_rule": {
      "description": "matching-rules.json 中的受控关键词规则：随不可变评定树版本发布，运行时不可编辑。只有 auto_bind 为真、目标节点在当前适用范围内且结果唯一时才允许自动绑定。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "target_node_id",
        "bridge_type_id",
        "component_category_id",
        "positive_keywords",
        "auto_bind",
        "sort_order"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "target_node_id": {"type": "string", "minLength": 1},
        "bridge_type_id": {"type": "string", "minLength": 1},
        "component_category_id": {"type": "string", "minLength": 1},
        "positive_keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "auto_bind": {"type": "boolean"},
        "sort_order": {"type": "integer"},
        "rule_note": {"type": "string"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "display_name",
        "node_type",
        "sort_order",
        "bridge_type_ids",
        "component_category_ids",
        "scoring_mode",
        "is_selectable",
        "source_ids"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "display_name": {"type": "string", "minLength": 1},
        "node_type": {
          "enum": [
            "root",
            "bridge_type_group",
            "structure_group",
            "component_group",
            "defect",
            "placeholder"
          ]
        },
        "sort_order": {"type": "integer"},
        "bridge_type_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "component_category_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "scoring_mode": {
          "enum": ["inherit_h21", "reference_h21", "non_scoring"]
        },
        "h21_indicator_id": {"type": "string", "minLength": 1},
        "is_selectable": {"type": "boolean"},
        "organization_note": {"type": "string"},
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
